        "heading-l/weight": { "type": "FLOAT", "values": { "Default": 600 } },
        "heading-l/letter-spacing": {
          "type": "FLOAT",
          "values": { "Default": -0.58 }
        },

        "heading-m/size": { "type": "FLOAT", "values": { "Default": 24 } },
        "heading-m/line-height": {
          "type": "FLOAT",
          "values": { "Default": 32 }
        },
        "heading-m/weight": { "type": "FLOAT", "values": { "Default": 600 } },
        "heading-m/letter-spacing": {
